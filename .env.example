# Base de datos (docker compose up -d)
DATABASE_URL=postgresql://amparo:amparo@localhost:5433/amparo

# LLM local con Ollama (recomendado para 16 GB de RAM sin GPU)
LLM_PROVEEDOR=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODELO=qwen2.5:3b
LLM_CONTEXTO=4096
LLM_TEMPERATURA=0.3

# --- Alternativa por API (más rápida en la exposición). Descomente: ---
# LLM_PROVEEDOR=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=su_clave
# LLM_MODELO=llama-3.3-70b-versatile

# Embeddings (siempre locales por Ollama)
EMBED_MODELO=embeddinggemma

# RAG
RAG_K=5
RAG_UMBRAL=0.30

# Voz
WHISPER_MODELO=small        # base = más rápido, small = más preciso
WHISPER_COMPUTE=int8
PIPER_VOZ=modelos/es_MX-claude-high.onnx
